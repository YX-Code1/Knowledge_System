# 本地配置模板：复制本文件并改名为 application-local.yml，填入你自己的真实配置即可
# application-local.yml 已被 .gitignore 排除，不会提交到仓库
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/knowledge_base?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: 你的MySQL密码
  data:
    redis:
      host: localhost
      port: 6379
      password: 你的Redis密码（无密码留空）
  mail:
    username: 你的发件邮箱
    password: 你的SMTP授权码

jwt:
  secret: 至少32位的随机密钥
