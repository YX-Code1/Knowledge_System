# 复制本文件为 .env 后填写真实值（.env 不入库）
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env

# 数据库 root 密码（容器内部与宿主机映射端口共用）
MYSQL_PASSWORD=please-change-me

# Redis 密码
REDIS_PASSWORD=please-change-me

# JWT 签名密钥，至少 32 字节
# 生成方式：openssl rand -hex 32
JWT_SECRET=please-generate-a-32-byte-random-secret

# 以下可选：留空则对应功能降级，不影响其他模块
MAIL_USERNAME=
MAIL_PASSWORD=
AI_DEEPSEEK_API_KEY=
AI_SILICONFLOW_API_KEY=
